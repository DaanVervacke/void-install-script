#!/bin/bash
# Basic checks and setup before the installer reaches configuration

echo "Running basic checks..."

[ "$(id -u)" -ne 0 ] &&
    echo -e "${RED}Please execute this script as root.${NC}" && exit 1

dependencies=("$(pwd)/modules" \
"setup/base" \
"setup/desktop" \
"setup/disk" \
"setup/chroot" \
"misc/greetd-run" \
"misc/60-ukify" \
"misc/zbmconfig.yaml" \
"misc/zol.conf")

for i in ${dependencies[@]}; do
    [ -e "$i" ] ||
        { commandFailure="$i appears to be missing. This could be because it is incorrectly named, or it does not exist." ; die ; }
done

[ -n "$modulesDialogArray" ] &&
    unset modulesDialogArray

[ -e "/sys/firmware/efi" ] ||
    { commandFailure="This script only supports UEFI systems, but it appears we have booted as BIOS." ; die ; }

case "$(uname -m)" in
    x86_64)
        platform="x86_64"
    ;;
    aarch64)
        # Only Apple Silicon (Asahi) is supported on aarch64
        grep -q "apple,arm-platform" /proc/device-tree/compatible 2>/dev/null ||
            { commandFailure="This aarch64 system does not appear to be an Apple Silicon Mac, which is the only supported aarch64 platform." ; die ; }

        platform="asahi"
    ;;
    *)
        commandFailure="This systems CPU architecture is not currently supported by this installer." ; die
    ;;
esac

# if the host doesn't have zfs utils, don't populate
# TODO: this needs better verification in the future.
which zfs &>/dev/null ||
    zfspossible=no

# zfs is not supported on Apple Silicon
[ "$platform" == "asahi" ] &&
    zfspossible=no

if [ "$platform" == "asahi" ]; then
    echo "Locating the Asahi EFI System Partition..."

    # m1n1 exposes the PARTUUID of the ESP it was booted from in the device tree
    [ -e /proc/device-tree/chosen/asahi,efi-system-partition ] ||
        { commandFailure="Unable to determine the Asahi ESP from the device tree. Please make sure the Asahi Linux 'UEFI environment only' install has been completed from macOS." ; die ; }

    espPartuuid=$(tr -d '\0' < /proc/device-tree/chosen/asahi,efi-system-partition)
    esp=$(blkid -t PARTUUID="$espPartuuid" -o device | head -n 1)

    [ -n "$esp" ] && [ -b "$esp" ] ||
        { commandFailure="Unable to find the Asahi ESP with PARTUUID $espPartuuid." ; die ; }

    espDisk="/dev/$(lsblk -no PKNAME "$esp" | head -n 1)"

    [ -b "$espDisk" ] ||
        { commandFailure="Unable to determine the disk containing the Asahi ESP ($esp)." ; die ; }
fi

echo "Finding out what libc is being used..."
if ldd --version | grep GNU ; then
    libc="glibc"
else
    libc="musl"
fi

echo "Testing for network connectivity..."
ping -c 1 gnu.org &>/dev/null && ping -c 1 fsf.org &>/dev/null ||
    { commandFailure="Network check has failed. Please make sure you are connected to the internet." ; die ; }

commandFailure="Dependency installation has failed."
xbps-install -Suy xbps || die
xbps-install -Suy dialog bc || die
xbps-install -Suy jfsutils || die

# it doesn't matter if these fail, do not || die
dialog --create-rc ~/.dialogrc
# i find the default blue background of dialog to be a little bit irritating, changing colors here.
sed -i -e 's/screen_color = (CYAN,BLUE,ON)/screen_color = (BLACK,BLACK,ON)/g' ~/.dialogrc
sed -i -e 's/title_color = (BLUE,WHITE,ON)/title_color = (BLACK,WHITE,ON)/g' ~/.dialogrc

# logfile
logFile="/tmp/void-install-script.log"

return 0
