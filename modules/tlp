#!/bin/bash

# Not applicable on Apple Silicon (tlp conflicts with asahi-macsmc-battery-udev)
[ "$platform" == "asahi" ] && return 1

title=tlp
description="- Advanced power management"
status=off

main() {
    commandFailure="tlp installation has failed." &&
        install tlp

    commandFailure="Enabling tlp has failed." &&
        enableService tlp

    return 0
}
