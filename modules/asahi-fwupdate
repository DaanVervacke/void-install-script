#!/bin/bash

# Only applicable on Apple Silicon
[ "$platform" != "asahi" ] && return 1

title=asahi-fwupdate
description="- Updates the Asahi vendor firmware on the ESP with asahi-fwupdate"
status=on

main() {
    commandFailure="Updating the Asahi vendor firmware has failed." &&
        system "asahi-fwupdate"

    return 0
}
